rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if the user is an admin
    // In this app, we will assign an admin flag or email checks.
    // We can store admin flags in the users collection or check a custom claim / standard list of emails.
    function isAdmin() {
      return isAuthenticated() && 
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          request.auth.token.email == 'admin@sweetbytani.com' ||
          request.auth.token.email == 'rahulhaldarx15@gmail.com'
        );
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Cakes Collection ---
    match /cakes/{cakeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Users can read their own orders. Admins can read all.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      // Anyone can create an order (both guests and logged-in users).
      allow create: if true;
      // Only admins can update order status/details.
      allow update, delete: if isAdmin();
    }

    // --- Gallery Collection ---
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      // Anyone can read reviews, but filtering for approved can be handled client-side or we can enforce rules.
      allow read: if true;
      // Signed in users can write a review.
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAdmin();
    }

    // --- FAQs Collection ---
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Offers Collection ---
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Settings Collection ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Homepage Custom CMS ---
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Notifications Collection ---
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
